@startuml
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FEFEFE

actor "Organisation User\n(Data Analyst)" as User
database "World SQL Database" as DB

rectangle "Population Reporting System" {

    ' Base Use Cases
    usecase "Generate Base Report" as Base
    usecase "Query Database" as DB_Query
    usecase "Format Output" as Format

    ' Specific Reports
    usecase "Generate Country Reports" as UC1
    usecase "Generate City Reports" as UC2
    usecase "Generate Capital City Reports" as UC3
    usecase "Generate Population Breakdowns" as UC4
    usecase "View Specific Populations" as UC5
    usecase "Generate Language Reports" as UC6

    ' Extensions (Variations)
    usecase "Filter by Top N" as Ext_TopN
    usecase "Filter by Location\n(Continent/Region/District)" as Ext_Loc

}

' Relationships
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

' Include relationships (Mandatory steps)
UC1 ..> Base : <<include>>
UC2 ..> Base : <<include>>
UC3 ..> Base : <<include>>
UC4 ..> Base : <<include>>
UC5 ..> Base : <<include>>
UC6 ..> Base : <<include>>

Base ..> DB_Query : <<include>>
Base ..> Format : <<include>>

' Extend relationships (Optional variations)
Ext_TopN .> UC1 : <<extend>>
Ext_TopN .> UC2 : <<extend>>
Ext_TopN .> UC3 : <<extend>>

Ext_Loc .> UC1 : <<extend>>
Ext_Loc .> UC2 : <<extend>>
Ext_Loc .> UC3 : <<extend>>
Ext_Loc .> UC4 : <<extend>>
Ext_Loc .> UC5 : <<extend>>

' Database connection
DB_Query ..> DB : <<queries>>

note right of User
  Interacts via CLI
  or API to request
  specific reports
end note
@enduml